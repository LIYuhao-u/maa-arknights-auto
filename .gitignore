# ── 运行时产物（含个人运行数据，不入库）────────────────────────────────
logs/
dashboard/index.html
*.log

# ── Python 缓存 ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.pytest_cache/

# ── 本机配置：含个人路径 / 主机信息，不入库；模板见 config.example.json ──
config.json
config.json.bak*
config.verify.json
tests/config.verify.json
tests/tasks.verify.json

# ── 编辑器 / 系统 ────────────────────────────────────────────────────
.vscode/
.idea/
Thumbs.db
desktop.ini
*.swp

